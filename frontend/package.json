{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "agent": "backend/.venv/bin/python -m backend.app",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "eval:reading": "node scripts/evaluate-reading.mjs",
    "eval:reading:py": "backend/.venv/bin/python -m backend.evaluate_reading",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:agent": "backend/.venv/bin/python -m pytest backend/tests",
    "test:reference": "node --test server-js-reference/tests/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0",
    "vite": "6.4.3"
  }
}
